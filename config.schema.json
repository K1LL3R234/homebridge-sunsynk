{
    "pluginAlias": "Sunsynk",
    "pluginType": "platform",
    "singular": true,
    "headerDisplay": "Sunsynk Homebridge plugin.",
    "footerDisplay": "Developed by Chris Posthumus",
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "title": "Name",
                "type": "string",
                "required": true,
                "default": "Sunsynk Inverter",
                "description": "You shouldn't need to change this."
            },
            "options": {
                "title": "",
                "type": "object",
                "required": true,
                "properties": {
                    "username": {
                        "title": "Username",
                        "type": "string",
                        "required": true
                    },
                    "password": {
                        "title": "Password",
                        "type": "string",
                        "required": true
                    },
                    "pollInterval": {
                        "title": "Poll interval (in minutes)",
                        "type": "number",
                        "required": true,
                        "default": 10,
                        "minimum": 1,
                        "maximum": 60
                    },
                    "lowbatt": {
                        "title": "Low Battery in %",
                        "type": "number",
                        "required": true,
                        "default": 20,
                        "minimum": 1,
                        "maximum": 100
                    },
                    "debug": {
                        "title": "Enable Debug Logging",
                        "type": "boolean",
                        "default": false,
                        "required": true
                    },
                    "plantId": {
                        "title": "Plant ID",
                        "type": "string",
                        "description": "Optional. Only needed when the Sunsynk account has more than one plant. Leave empty to use the first; the Homebridge log lists every plant with its ID at startup."
                    },
                    "inverterSn": {
                        "title": "Inverter Serial Number",
                        "type": "string",
                        "description": "Optional. Only needed when the plant has more than one inverter. Leave empty to use the first; the Homebridge log lists every inverter with its serial number at startup."
                    },
                    "sensors": {
                        "title": "Sensors",
                        "type": "object",
                        "description": "Choose which sensors are published to HomeKit. This is optional. Leaving everything ticked keeps the default behaviour of publishing all of them. Unticking a sensor removes it from HomeKit on the next restart, along with any automations, scenes, favourites and room assignment that use it.",
                        "properties": {
                            "currentPvPower": {
                                "title": "Current PV Power W",
                                "type": "boolean",
                                "default": true
                            },
                            "todayPvEnergy": {
                                "title": "Today PV Electricity kWh",
                                "type": "boolean",
                                "default": true
                            },
                            "monthPvEnergy": {
                                "title": "Month PV Electricity kWh",
                                "type": "boolean",
                                "default": true
                            },
                            "yearPvEnergy": {
                                "title": "Year PV Electricity kWh",
                                "type": "boolean",
                                "default": true
                            },
                            "totalPvEnergy": {
                                "title": "Total PV Electricity kWh",
                                "type": "boolean",
                                "default": true
                            },
                            "batteryPower": {
                                "title": "Battery Power W",
                                "type": "boolean",
                                "default": true
                            },
                            "batterySoc": {
                                "title": "Battery SOC",
                                "type": "boolean",
                                "default": true
                            },
                            "loadPower": {
                                "title": "Load Power W",
                                "type": "boolean",
                                "default": true
                            },
                            "gridPower": {
                                "title": "Grid Power",
                                "type": "boolean",
                                "default": true
                            }
                        }
                    }
                }
            }
        }
    }
}